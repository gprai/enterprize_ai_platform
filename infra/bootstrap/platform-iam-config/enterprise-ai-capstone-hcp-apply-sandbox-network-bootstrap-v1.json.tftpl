{
  "Statement": [
    {
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateVpcEndpoint"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "sandbox",
          "aws:ResourceTag/Project": "enterprise-ai-platform",
          "aws:ResourceTag/Repository": "enterprise-ai-platform",
          "ec2:Region": "ap-southeast-1"
        }
      },
      "Effect": "Allow",
      "Resource": "${sandbox_vpc_arn}",
      "Sid": "CreateNetworkResourcesInExactSandboxVpc"
    },
    {
      "Action": [
        "ec2:CreateTags"
      ],
      "Condition": {
        "ArnEquals": {
          "ec2:Vpc": "${sandbox_vpc_arn}"
        },
        "StringEquals": {
          "ec2:Region": "ap-southeast-1",
          "aws:RequestTag/Owner": "Gyan-Prakash-Rai",
          "aws:RequestTag/CostCenter": "Personal-Learning",
          "aws:RequestTag/Environment": "sandbox",
          "aws:RequestTag/ManagedBy": "terraform",
          "aws:RequestTag/Project": "enterprise-ai-platform",
          "aws:RequestTag/Feature": "MVP-001",
          "aws:RequestTag/Repository": "enterprise-ai-platform",
          "aws:RequestTag/Name": "enterprise-ai-sandbox-default-restricted",
          "aws:RequestTag/ExpiresAt": "${workload_expires_at}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "CostCenter",
            "Environment",
            "ExpiresAt",
            "Feature",
            "ManagedBy",
            "Name",
            "Owner",
            "Project",
            "Repository"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "${sandbox_default_security_group_arn}",
      "Sid": "BootstrapExactSandboxDefaultSecurityGroupTags"
    }
  ],
  "Version": "2012-10-17"
}
