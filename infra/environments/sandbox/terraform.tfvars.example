# destination Regions. aws_region and bedrock_region are validated independently.
# Silent model, provider, inference-profile, application-region, or fallback-
# region substitution is prohibited.

aws_account_id = "526338061652"

aws_region = "ap-southeast-1"

aws_fallback_region = null

network_ownership_mode = "project_owned"

vpc_id = null

private_subnet_ids = []

vpc_cidr = "10.60.0.0/16"

private_subnet_cidrs = [
  "10.60.10.0/24",
  "10.60.11.0/24",
]

dns_domain = null

egress_mode = "private_endpoints_only"

vpc_endpoint_services = [
  "S3",
  "DynamoDB",
  "ECR API",
  "ECR DKR",
  "EKS",
  "EKS Auth",
  "STS",
  "EC2",
  "CloudWatch Logs",
  "CloudWatch Monitoring",
  "X-Ray",
  "KMS",
  "Secrets Manager",
  "Bedrock Runtime",
]

